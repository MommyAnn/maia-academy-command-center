# M.A.I.A. Business Solutions Academy — server configuration.
# Copy to .env (never commit .env).

# Port the web server listens on.
PORT=8787

# Public URL of the site (used for secure-cookie and origin checks in production).
PUBLIC_URL=http://localhost:8787

# Where the SQLite database and uploaded images are stored.
# In production this MUST be a persistent disk/volume.
DATA_DIR=./data

# Optional: create the first admin automatically on boot if no admin exists.
# Prefer `npm run create-admin` instead and leave these empty.
ADMIN_EMAIL=
ADMIN_PASSWORD=
