{
  "name": "maia-business-solutions-academy",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "M.A.I.A. Business Solutions Academy — public school website, student portal and admin dashboard.",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "dev": "tsx watch --ignore ./src --ignore ./data server/index.ts",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "create-admin": "tsx server/create-admin.ts",
    "test": "tsx --test server/tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "express": "^5.1.0",
    "lucide-react": "^0.511.0",
    "multer": "^2.0.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "tsx": "^4.20.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0"
  }
}
