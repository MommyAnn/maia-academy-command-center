// M.A.I.A. Academy Command Center — Production Database Foundation (Phase 1)
//
// This schema is the production twin of the domain model already proven out
// in the frontend across Steps 1-12 (src/types/*.ts) — field names and
// status enums mirror those files deliberately, so this is a faithful
// translation of working business logic into a real relational database,
// not an invented one.
//
// Core identity model (spec section 4): Person is the one stable human
// identity. Lead and Student both point back to the same Person row when
// they are the same human being, so a person who registers for a webinar
// and later enrolls is never duplicated — LeadStudentConversion preserves
// the link explicitly, exactly like the existing leadId/convertedToStudentId
// pattern in src/types/webinar.ts and src/types/student.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// IDENTITY
// ---------------------------------------------------------------------------

model Person {
  id           String   @id @default(cuid())
  fullName     String
  facebookName String?
  email        String?
  contactNumber String?
  city         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  lead    Lead?
  student Student?
  staff   Staff?
  user    User?
  communicationLogs CommunicationLog[]
  ghlContactMap     GhlContactMap?

  @@index([email])
}

// A real, authenticatable account. Every login-capable identity (Owner,
// Staff, Student) has exactly one User row. A Person may exist without a
// User (e.g. a Lead who never enrolls, or a Student before portal access
// is provisioned).
model User {
  id            String    @id @default(cuid())
  personId      String    @unique
  person        Person    @relation(fields: [personId], references: [id])
  email         String    @unique
  passwordHash  String
  roleId        String
  role          Role      @relation(fields: [roleId], references: [id])
  status        UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions        Session[]
  passwordResets  PasswordResetToken[]
  activityLogs    ActivityLog[]         @relation("ActorUser")

  @@index([roleId])
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

// Server-side, revocable sessions (spec section 8: "Session Revocation").
// Only a hash of the session token is stored — the raw token lives solely
// in the httpOnly cookie, exactly like a password is never stored in
// reversible form.
model Session {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String   @unique
  createdAt    DateTime @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  userAgent    String?
  ipAddress    String?

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  @@index([userId])
}

// Roles are real, admin-manageable rows (spec section 12: "do not hard-code
// business permissions unnecessarily") — not a hard-coded enum. Seeded with
// the same 10 starting roles the frontend already ships (Owner,
// Administrator, Finance Officer, Enrollment Officer, Student Success
// Coordinator, Training Coordinator, Inventory Officer, Marketing Staff,
// Support Staff, Custom Role) — see prisma/seed.ts.
model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  isCustom    Boolean  @default(false)
  createdAt   DateTime @default(now())

  users       User[]
  staff       Staff[]
  permissions RolePermission[]
}

enum PermissionAction {
  VIEW
  CREATE
  EDIT
  VERIFY
  EXPORT
}

// module is validated at the application layer against the same
// PERMISSION_MODULES list as src/types/staff.ts (kept in server/src/rbac/modules.ts)
// so the two never drift apart.
model RolePermission {
  id      String            @id @default(cuid())
  roleId  String
  role    Role              @relation(fields: [roleId], references: [id], onDelete: Cascade)
  module  String
  action  PermissionAction
  allowed Boolean           @default(false)

  @@unique([roleId, module, action])
  @@index([roleId])
}

// ---------------------------------------------------------------------------
// LEADS (spec section 4: a Person may begin as a Lead and later become a Student)
// ---------------------------------------------------------------------------

model Lead {
  id             String    @id @default(cuid())
  leadDisplayId  String    @unique // e.g. LEAD-2026-000001
  personId       String    @unique
  person         Person    @relation(fields: [personId], references: [id])
  // ORIGINAL / FIRST-TOUCH acquisition attribution (spec section 12) — set
  // ONCE, at Lead creation, and never overwritten by a later registration.
  // A WebinarRegistration's own source/campaign/UTM fields are the LATEST
  // touch instead — see that model.
  source         String?
  campaign       String?
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  utmContent     String?
  utmTerm        String?
  landingPage    String?
  referralSource String?
  firstRegistrationDate DateTime?
  businessStatus String?
  businessName   String?
  pipelineStage  LeadStage @default(NOT_CONTACTED)
  // A lightweight lifecycle marker distinct from the funnel position above
  // (spec section 2's "Status" field, listed separately from "Current
  // Pipeline Stage") — Active | Converted | Inactive.
  status         String    @default("Active")
  leadOwnerId    String?
  lastFollowUpAt DateTime?
  nextFollowUpAt DateTime?
  // Communication eligibility (spec section 48) — registering is never
  // treated as unlimited marketing permission; each channel is its own
  // explicit flag, defaulting closed.
  canEmail       Boolean   @default(false)
  canSms         Boolean   @default(false)
  canWhatsapp    Boolean   @default(false)
  optedOut       Boolean   @default(false)
  dnd            Boolean   @default(false)
  consentSource  String?
  consentVersion String?
  consentDate    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  activity          LeadActivity[]
  webinarRegistrations WebinarRegistration[]
  followUps         FollowUp[]
  notes             LeadNote[]
  pipelineHistory   LeadPipelineHistory[]
  consentEvents     LeadConsentEvent[]
  conversion        LeadStudentConversion?
  feedbackSubmissions FeedbackSubmission[]
  paymentTransactions PaymentTransaction[]

  @@index([pipelineStage])
  @@index([leadOwnerId])
}

enum LeadStage {
  NOT_CONTACTED
  FOLLOW_UP_NEEDED
  INTERESTED
  CONSIDERING
  RESERVATION_PAID
  ENROLLED
  NOT_INTERESTED
  NO_RESPONSE
}

// Append-only (spec section 18) — the current stage lives on Lead itself,
// but every transition is preserved here too, so "how did this Lead get
// here" is never lost the way an in-place status update would lose it.
model LeadPipelineHistory {
  id             String   @id @default(cuid())
  leadId         String
  lead           Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  previousStage  LeadStage?
  newStage       LeadStage
  changedById    String?
  reason         String?
  occurredAt     DateTime @default(now())

  @@index([leadId])
}

model LeadNote {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorId  String
  note      String
  createdAt DateTime @default(now())

  @@index([leadId])
}

// Append-only consent history (spec sections 7, 48) — mirrors the
// ConsentEvent pattern from Phase 3's marketing consent exactly, scoped to
// webinar/communication consent instead of testimonial-marketing consent.
// A withdrawal/opt-out is a NEW row, never an edit to a prior one.
model LeadConsentEvent {
  id             String   @id @default(cuid())
  leadId         String
  lead           Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  action         String   // Granted | Updated | Opted Out
  canEmail       Boolean
  canSms         Boolean
  canWhatsapp    Boolean
  optedOut       Boolean
  consentVersion String?
  source         String
  occurredAt     DateTime @default(now())

  @@index([leadId])
}

model LeadActivity {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  action    String
  userLabel String
  occurredAt DateTime @default(now())

  @@index([leadId])
}

// Preserves the Lead <-> Student link permanently (spec section 25) —
// converting a Lead never deletes or merges the Lead row, it links it.
model LeadStudentConversion {
  id          String   @id @default(cuid())
  leadId      String   @unique
  lead        Lead     @relation(fields: [leadId], references: [id])
  studentId   String   @unique
  student     Student  @relation(fields: [studentId], references: [id])
  convertedAt DateTime @default(now())
  convertedBy String
}

// ---------------------------------------------------------------------------
// STUDENTS, BATCHES, PACKAGES, ENROLLMENTS
// ---------------------------------------------------------------------------

model Batch {
  id                   String      @id @default(cuid())
  code                 String      @unique // e.g. "14"
  label                String               // e.g. "Batch 14"
  program              String?
  startDate            DateTime?
  endDate              DateTime?
  enrollmentPeriodStart DateTime?
  enrollmentPeriodEnd  DateTime?
  trainingScheduleNotes String?
  status               BatchStatus @default(UPCOMING)
  capacity             Int?
  notes                String?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  // isActive is kept (not renamed) so the Phase 1 migration's existing rows
  // and any code already reading it keep working — `status` is the new,
  // richer field Phase 2 adds; the two are kept in sync at the service layer
  // (isActive == status in {OPEN, ACTIVE}).
  isActive             Boolean     @default(true)

  students    Student[]
  enrollments Enrollment[]
  payments    PaymentTransaction[]
  trainingSessions TrainingSession[]
  certificates Certificate[]
  feedbackRequests FeedbackRequest[]
}

enum BatchStatus {
  UPCOMING
  OPEN
  ACTIVE
  COMPLETED
  ARCHIVED
}

model Package {
  id           String   @id @default(cuid())
  name         String   @unique // e.g. "Premium", "VIP", "Dual VIP"
  description  String?
  defaultPrice Decimal? @db.Decimal(12, 2)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  students    Student[]
  enrollments Enrollment[]
  payments    PaymentTransaction[]
  aiAccess    AiPackageAccess[]
  aiUsageLimits AiUsageLimit[]
  courseAccess PackageCourseAccess[]
}

model Student {
  id               String   @id @default(cuid())
  studentDisplayId String   @unique // e.g. MAIA-B14-0001
  personId         String   @unique
  person           Person   @relation(fields: [personId], references: [id])
  batchId          String
  batch            Batch    @relation(fields: [batchId], references: [id])
  packageId        String
  package          Package  @relation(fields: [packageId], references: [id])
  enrollmentStatus String   // mirrors StudentRecord.enrollmentStatus's existing string values
  attendanceMode   String?  // "Face-to-Face" | "Zoom"
  masterBrainStatus MasterBrainStatus @default(NOT_STARTED)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  leadConversion   LeadStudentConversion?
  enrollments      Enrollment[]
  businesses       Business[]
  payments         PaymentTransaction[]
  documents        Document[]
  taobaoRecord     TaobaoRecord?
  masterBrainSubmissions MasterBrainSubmission[]
  courseAccess     CourseAccessGrant[]
  lessonProgress   LessonProgress[]
  trainingAttendance TrainingAttendance[]
  certificates     Certificate[]
  feedbackSubmissions FeedbackSubmission[]
  incentiveRedemptions IncentiveRedemption[]
  aiManualGrants   AiManualGrant[]
  supportRequests  SupportRequest[]
  activityLogs     ActivityLog[] @relation("ActorStudent")
  requirements     Requirement[]
  notes            StudentNote[]

  @@index([batchId])
  @@index([packageId])
}

enum MasterBrainStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  UNDER_REVIEW
  NEEDS_REVISION
  APPROVED_FOR_GENERATION
  GENERATING
  DRAFT_READY
  FINAL_REVIEW
  COMPLETED
  PUBLISHED
}

// A student may have more than one enrollment over time (spec section 5) —
// never a field on Student itself.
model Enrollment {
  id                 String   @id @default(cuid())
  enrollmentDisplayId String  @unique // e.g. ENR-2026-000001
  studentId          String
  student            Student  @relation(fields: [studentId], references: [id])
  batchId            String
  batch              Batch    @relation(fields: [batchId], references: [id])
  packageId          String
  package            Package  @relation(fields: [packageId], references: [id])
  attendanceChoice   String?  // "Face-to-Face" | "Zoom"
  companionName      String?
  // CRITICAL (spec section 8): the agreed price at the moment of enrollment,
  // frozen forever — later changes to Package.defaultPrice must never alter
  // this or any already-derived balance for this enrollment.
  packagePriceSnapshot Decimal @db.Decimal(12, 2)
  discount           Decimal  @default(0) @db.Decimal(12, 2)
  netAmountDue       Decimal  @db.Decimal(12, 2)
  status             String
  source             String?
  enrolledAt         DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  payments PaymentTransaction[]

  @@index([studentId])
  @@index([batchId])
}

// One student may run more than one business (spec sections 4-5, 15) — kept
// isolated from every other business via businessId scoping on Master
// Brain, AI Projects, and AI Generations below.
model Business {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id])
  name      String
  createdAt DateTime @default(now())

  masterBrainSubmissions MasterBrainSubmission[]
  aiProjects             AiProject[]
  aiGenerations          AiGeneration[]
  documents              Document[]

  @@index([studentId])
}

// ---------------------------------------------------------------------------
// FINANCE — transaction ledger only; balance/status are always derived,
// never stored (spec sections 23-24). See server/src/modules/finance/calc.ts.
// ---------------------------------------------------------------------------

model PaymentTransaction {
  id               String   @id @default(cuid())
  paymentDisplayId String   @unique // e.g. PAY-B14-000001
  // Exactly one of studentId/leadId is set at creation (enforced at the
  // service layer, not the DB) — a Lead's reservation payment (spec section
  // 14) has no Student yet. Converting the Lead re-parents this SAME row by
  // setting studentId, so the payment is carried forward once, never
  // duplicated.
  studentId        String?
  student          Student? @relation(fields: [studentId], references: [id])
  leadId           String?
  lead             Lead?    @relation(fields: [leadId], references: [id])
  enrollmentId     String?
  enrollment       Enrollment? @relation(fields: [enrollmentId], references: [id])
  batchId          String
  batch            Batch    @relation(fields: [batchId], references: [id])
  packageId        String
  package          Package  @relation(fields: [packageId], references: [id])
  paymentDate      DateTime
  type             String
  amount           Decimal  @db.Decimal(12, 2)
  method            String
  referenceNumber   String?
  status            PaymentTransactionStatus @default(PENDING_VERIFICATION)
  proofDocumentId   String?
  proofDocument     Document? @relation(fields: [proofDocumentId], references: [id])
  notes             String?
  recordedById      String
  verifiedById      String?
  verifiedAt        DateTime?
  rejectedReason    String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([studentId])
  @@index([status])
}

enum PaymentTransactionStatus {
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
  CANCELLED
}

model Expense {
  id        String   @id @default(cuid())
  category  String
  amount    Decimal  @db.Decimal(12, 2)
  date      DateTime
  status    ExpenseStatus @default(ACTIVE)
  voidReason String?
  receiptDocumentId String?
  receiptDocument   Document? @relation(fields: [receiptDocumentId], references: [id])
  recordedById String
  createdAt DateTime @default(now())
}

enum ExpenseStatus {
  ACTIVE
  VOID
}

// ---------------------------------------------------------------------------
// DOCUMENTS / FILES — metadata + access classification (spec sections 18-22).
// The actual bytes live in whatever StorageDriver is configured
// (server/src/storage) — this table never stores file content itself.
// ---------------------------------------------------------------------------

model Document {
  id               String   @id @default(cuid())
  ownerStudentId   String?
  ownerStudent     Student? @relation(fields: [ownerStudentId], references: [id])
  ownerBusinessId  String?
  ownerBusiness    Business? @relation(fields: [ownerBusinessId], references: [id])
  documentType     String   // "ValidId" | "PaymentProof" | "CourseResource" | "FeedbackVideo" | "AiAsset" | ...
  originalFilename String
  storageKey       String   @unique // path/key inside the storage driver, never guessable
  mimeType         String
  sizeBytes        Int
  status           DocumentStatus @default(PENDING)
  accessClassification DocumentAccessClass
  uploadedById     String
  uploadedAt       DateTime @default(now())

  paymentProofOf PaymentTransaction[]
  currentForRequirements Requirement[]
  lessonResources  LessonResource[]
  feedbackVideoOf  FeedbackSubmission[]
  incentiveResourceOf Incentive[]
  expenseReceiptOf Expense[]

  @@index([ownerStudentId])
  @@index([ownerBusinessId])
}

enum DocumentStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum DocumentAccessClass {
  PRIVATE_STUDENT
  PRIVATE_STAFF
  FINANCE_SENSITIVE
  ACADEMY_INTERNAL
  COURSE_RESTRICTED
  MARKETING_APPROVED
  PUBLIC
}

model TaobaoRecord {
  id        String   @id @default(cuid())
  studentId String   @unique
  student   Student  @relation(fields: [studentId], references: [id])
  status    String
  notes     String?
  updatedAt DateTime @updatedAt
  // Deliberately no password field — matches the existing frontend's
  // explicit "the Taobao password is never requested, stored, or displayed" rule.
}

// ---------------------------------------------------------------------------
// REQUIREMENTS (Phase 2) — the review/status trail is a record OF a
// Document, never the same row: resubmitting swaps in a new Document but
// keeps every prior RequirementReview entry, so "silently erasing the
// previous review trail" (spec section 36) is structurally impossible.
// ---------------------------------------------------------------------------

model Requirement {
  id           String   @id @default(cuid())
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id])
  enrollmentId String?
  type         String   // "ValidId" | "PaymentProof" | ...
  currentDocumentId String?
  currentDocument   Document? @relation(fields: [currentDocumentId], references: [id])
  status       RequirementStatus @default(PENDING)
  submittedAt  DateTime?
  reviewedAt   DateTime?
  reviewedById String?
  reasonNote   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  reviews RequirementReview[]

  @@unique([studentId, type])
  @@index([studentId])
}

enum RequirementStatus {
  PENDING
  VERIFIED
  REJECTED
}

/** Append-only review trail — never overwritten, never deleted, even across a resubmission (spec section 36). */
model RequirementReview {
  id            String   @id @default(cuid())
  requirementId String
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  documentId    String?
  status        RequirementStatus
  reason        String?
  actedById     String?
  occurredAt    DateTime @default(now())

  @@index([requirementId])
}

// ---------------------------------------------------------------------------
// STUDENT ADMIN NOTES — staff-only, a Student must never see these (spec
// section 32).
// ---------------------------------------------------------------------------

model StudentNote {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id])
  authorId  String
  note      String
  createdAt DateTime @default(now())

  @@index([studentId])
}

// ---------------------------------------------------------------------------
// DOMAIN EVENTS (spec sections 37-39) — internal only. Recorded so a future
// integration phase (GHL, email/SMS) can subscribe without coupling core
// business logic to any external system; nothing in Phase 2 dispatches
// these anywhere outside this table.
// ---------------------------------------------------------------------------

model DomainEvent {
  id          String   @id @default(cuid())
  type        String   // "STUDENT_CREATED" | "ENROLLMENT_CREATED" | "ENROLLMENT_CONFIRMED" | "STUDENT_FULLY_PAID" | "REQUIREMENT_SUBMITTED" | "REQUIREMENT_VERIFIED" | "REQUIREMENT_REJECTED" | ...
  studentId   String?
  enrollmentId String?
  payloadJson Json
  occurredAt  DateTime @default(now())
  // Set once the Phase 5 GHL outbox consumer actually processes this event
  // (SUCCESS) — the seam this field's own Phase 2 comment anticipated.
  // Still null for any event type Phase 5 doesn't map to a GHL action.
  processedAt DateTime?

  outboxEvent IntegrationOutboxEvent?

  @@index([type])
  @@index([studentId])
}

// ---------------------------------------------------------------------------
// COUNTER — atomic, concurrency-safe sequence generation (spec section 29)
// for human-readable IDs (MAIA-B14-0001, ENR-2026-000001, ...). An
// upsert-increment is race-free under Postgres's MVCC without needing
// explicit row locking in application code.
// ---------------------------------------------------------------------------

model Counter {
  scope String @id // e.g. "student:14", "enrollment:2026", "payment:14"
  value Int    @default(0)
}

// ---------------------------------------------------------------------------
// MASTER BRAIN — submission (raw answers) and document (generated, versioned)
// are two permanently separate records (spec section 16), exactly like the
// existing MasterBrainSubmission / MasterBrainDocument split.
// ---------------------------------------------------------------------------

model MasterBrainSubmission {
  id               String   @id @default(cuid())
  studentId        String
  student          Student  @relation(fields: [studentId], references: [id])
  // One submission per BUSINESS, not per Student (Phase 6 spec section 33:
  // a Student may own several Businesses, each with its own independent
  // Master Brain questionnaire/document lineage — never shared or mixed).
  businessId       String   @unique
  business         Business @relation(fields: [businessId], references: [id])
  status           MasterBrainStatus @default(NOT_STARTED)
  currentStep      Int      @default(1)
  progressPercent  Int      @default(0)
  answersJson      Json     // the full 12-step questionnaire payload
  submissionVersion Int     @default(1)
  startedAt        DateTime?
  lastSavedAt      DateTime?
  submittedAt      DateTime?
  reviewedById     String?
  reviewedAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  documents        MasterBrainDocument[]
  revisionRequests MasterBrainRevisionRequest[]

  @@index([businessId])
}

model MasterBrainRevisionRequest {
  id           String   @id @default(cuid())
  submissionId String
  submission   MasterBrainSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  section      String
  question     String?
  reason       String
  resolved     Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model MasterBrainDocument {
  id                          String   @id @default(cuid())
  submissionId                String
  submission                  MasterBrainSubmission @relation(fields: [submissionId], references: [id])
  businessId                  String
  documentVersion             Int
  generatedFromSubmissionVersion Int
  sectionsJson                Json
  // AI_ASSISTED | MANUAL (spec section 14) — draft generation is never
  // silently treated as final; isCurrentPublished only ever flips true via
  // an explicit human publish action, whichever method produced the draft.
  generationMethod            String   @default("MANUAL")
  aiProvider                  String?
  aiModel                     String?
  aiPromptVersionId           String?
  // Missing-section / unsupported-claim flags recorded at generation time
  // (spec sections 16-17, 75) — surfaced to the human reviewer, never
  // silently resolved by the AI itself.
  validationJson               Json?
  generatedById                String?
  isCurrentPublished          Boolean  @default(false)
  generatedAt                 DateTime @default(now())
  publishedAt                 DateTime?
  publishedById                String?

  aiGenerations AiGeneration[]

  @@unique([submissionId, documentVersion])
  @@index([businessId, isCurrentPublished])
}

// ---------------------------------------------------------------------------
// LMS — course access resolution + progress are always live-computed by the
// service layer (server/src/modules/lms/access.ts), never stored as a
// percent (spec section 14).
// ---------------------------------------------------------------------------

model Course {
  id          String   @id @default(cuid())
  courseDisplayId String @unique // e.g. CRS-000001
  title       String
  slug        String?  @unique
  description String?
  category    String
  instructor  String?
  // No real image upload pipeline exists (matches the frontend's honest
  // `thumbnailLabel` stand-in) — a short label/emoji, never a real file.
  thumbnailLabel String?
  estimatedDuration String?
  displayOrder Int      @default(0)
  accessType  CourseAccessType @default(PACKAGE)
  certificateEligible Boolean @default(false)
  // DRAFT | PUBLISHED | UNPUBLISHED | ARCHIVED — plain string, configurable,
  // matches the frontend's CourseStatus set exactly (spec section 12).
  status      String   @default("DRAFT")
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  modules      CourseModule[]
  accessGrants CourseAccessGrant[]
  packageAccess PackageCourseAccess[]
  bonusIncentives Incentive[]

  @@index([status])
}

// Course.accessType is the course-level DEFAULT policy (Package/Manual/
// Open); an individual CourseAccessGrant.source is a separate, richer,
// plain string (Package/Manual/Bonus/Promotion/Admin Override/Future
// Purchase/Feedback Incentive) layered on top — see resolveCourseAccess in
// server/src/modules/courses/access.ts.
enum CourseAccessType {
  PACKAGE
  MANUAL
  OPEN
}

model CourseModule {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String?
  order       Int
  status      String   @default("Active") // Active | Archived

  lessons Lesson[]

  @@index([courseId])
}

model Lesson {
  id             String   @id @default(cuid())
  lessonDisplayId String  @unique // e.g. LSN-000001
  moduleId       String
  module         CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  type           String   // Video Lesson | Text Lesson | Downloadable Resource | External Resource | Assignment | Quiz Placeholder | Live Session / Replay
  // Provider-agnostic embed reference only (e.g. a Vimeo video id), never a
  // raw playback URL — matches the frontend's honest videoRef field. No
  // real video-hosting API call exists anywhere in this build; see the
  // Phase 3 completion report's video-hosting status.
  videoEmbedRef  String?
  textContent    String?
  duration       String?
  order          Int
  status         String   @default("Draft") // Draft | Published
  completionRule String   @default("View") // View | Manual Mark Complete

  progress  LessonProgress[]
  resources LessonResource[]

  @@index([moduleId])
}

// A resource backed by real private storage (a Document row, reusing the
// exact same signed-URL/ownership-checked download path Phase 1 built for
// student documents) OR, for "External Link" resources only, a plain URL —
// never both, and never a public/guessable file path.
model LessonResource {
  id         String   @id @default(cuid())
  lessonId   String
  lesson     Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  type       String   // PDF | Worksheet | Template | Checklist | Prompt | Guide | External Link | Other
  label      String
  documentId String?
  document   Document? @relation(fields: [documentId], references: [id])
  url        String?  // only meaningful for type = "External Link"
  createdById String?
  createdAt  DateTime @default(now())

  @@index([lessonId])
}

model CourseAccessGrant {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id])
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id])
  // Plain string, not the narrower CourseAccessType enum — a grant's
  // origin has more shapes than a course's default policy (spec section
  // 18): Package | Manual | Bonus | Promotion | Admin Override | Future
  // Purchase | Feedback Incentive.
  source        String
  sourceReference String? // e.g. the Package id, or the IncentiveRedemption id
  grantedById String?
  grantedAt   DateTime @default(now())
  expiresAt   DateTime?
  status      String   @default("Active") // Active | Expired | Revoked
  revokedAt   DateTime?
  revokedById String?
  notes       String?

  @@unique([studentId, courseId])
  @@index([studentId])
}

// Configurable PACKAGE/PROGRAM -> COURSE ACCESS mapping (spec section 20)
// as a real table, never a hard-coded matrix in application code — an
// Admin can add/remove a row here without a code change.
model PackageCourseAccess {
  id        String   @id @default(cuid())
  packageId String
  package   Package  @relation(fields: [packageId], references: [id])
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id])
  createdAt DateTime @default(now())

  @@unique([packageId, courseId])
}

model LessonProgress {
  id             String   @id @default(cuid())
  studentId      String
  student        Student  @relation(fields: [studentId], references: [id])
  lessonId       String
  lesson         Lesson   @relation(fields: [lessonId], references: [id])
  status         String   @default("Not Started") // Not Started | In Progress | Completed
  startedAt      DateTime?
  completedAt    DateTime?
  lastAccessedAt DateTime @default(now())

  @@unique([studentId, lessonId])
  @@index([studentId])
}

// ---------------------------------------------------------------------------
// TRAINING / ATTENDANCE / CERTIFICATES
// ---------------------------------------------------------------------------

// `type`/`status` are deliberately plain configurable strings (spec section
// 2-3: "do not unnecessarily hard-code" training types/statuses) rather
// than enums — an Owner/Admin can introduce a new training type or status
// label without a schema migration, mirroring how Package/Batch already
// work in this schema.
model TrainingSession {
  id                String   @id @default(cuid())
  sessionDisplayId  String   @unique // e.g. TRN-B14-0001
  title             String
  description       String?
  type              String   // Face-to-Face | Zoom | Masterclass | Workshop | Orientation | Special Session | Other
  batchId           String?
  batch             Batch?   @relation(fields: [batchId], references: [id])
  program           String?
  date              DateTime
  startTime         String
  endTime           String
  venue             String?
  platform          String?
  meetingLink       String?
  meetingId         String?
  passcode          String?
  trainer           String?
  capacity          Int?
  status            String   @default("Draft") // Draft | Scheduled | Ongoing | Completed | Cancelled | Archived
  notes             String?
  createdById       String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  attendance TrainingAttendance[]

  @@index([batchId])
}

// One row per Student+Session covers BOTH eligibility/roster membership
// AND the attendance outcome (mirrors the frontend's single
// `SessionEnrollment` shape in src/types/training.ts) — a roster entry is
// created with status "Registered" before the session happens, then the
// SAME row is updated when attendance is marked. The @@unique constraint
// below is the actual duplicate-attendance guard (spec section 7): a
// second attendance record for the same Student+Session is structurally
// impossible, not just discouraged by the UI.
model TrainingAttendance {
  id            String   @id @default(cuid())
  sessionId     String
  session       TrainingSession @relation(fields: [sessionId], references: [id])
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id])
  eligibility   String   @default("Eligible") // Eligible | Not Eligible | Pending Review
  status        String   @default("Registered") // Registered | Present | Late | Absent | Excused | Online Attended
  checkInTime   DateTime?
  checkOutTime  DateTime?
  method        String?  // Quick Attendance | QR | Manual
  recordedById  String?
  recordedAt    DateTime?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([sessionId, studentId])
  @@index([studentId])
}

// Reissue never overwrites history (spec section 34): a reissue is a NEW
// row with `reissueOfId` pointing at the original, which is left
// untouched. Duplicate issuance of the SAME row is prevented by a status
// guard at the route layer (mirrors the payment-verify double-guard
// pattern from Phase 2) — the unique `certificateDisplayId` is the
// per-record collision guard.
model Certificate {
  id                String   @id @default(cuid())
  certificateDisplayId String @unique // e.g. CERT-B14-000001
  studentId         String
  student           Student  @relation(fields: [studentId], references: [id])
  batchId           String?
  batch             Batch?   @relation(fields: [batchId], references: [id])
  program           String?
  certificateType   String   @default("Program Completion")
  status            String   @default("Not Eligible") // Not Eligible | Eligible | For Preparation | Ready | Issued | Reissued
  completionDate    DateTime?
  preparedById      String?
  preparedAt        DateTime?
  issuedAt          DateTime?
  issuedById        String?
  fileDocumentId    String?  // null until real PDF generation exists (Phase 1 leaves this unset)
  notes             String?
  reissueOfId       String?
  reissueOf         Certificate? @relation("CertificateReissue", fields: [reissueOfId], references: [id])
  reissues          Certificate[] @relation("CertificateReissue")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([studentId])
  @@index([batchId])
}

// ---------------------------------------------------------------------------
// STAFF / TASKS / INVENTORY
// ---------------------------------------------------------------------------

model Staff {
  id         String   @id @default(cuid())
  personId   String   @unique
  person     Person   @relation(fields: [personId], references: [id])
  roleId     String
  role       Role     @relation(fields: [roleId], references: [id])
  status     UserStatus @default(ACTIVE)
  createdAt  DateTime @default(now())

  tasksCreated Task[] @relation("TaskCreatedBy")
  tasksAssigned Task[] @relation("TaskAssignedTo")
}

model Task {
  id          String   @id @default(cuid())
  taskDisplayId String @unique // e.g. TASK-2026-000001
  title       String
  status      String
  priority    String
  createdById String
  createdBy   Staff    @relation("TaskCreatedBy", fields: [createdById], references: [id])
  assignedToId String?
  assignedTo  Staff?   @relation("TaskAssignedTo", fields: [assignedToId], references: [id])
  autoTriggerKey String? @unique // dedup key for automatically-created tasks
  createdAt   DateTime @default(now())
  completedAt DateTime?
}

model InventoryItem {
  id          String   @id @default(cuid())
  sku         String   @unique
  name        String
  category    String
  unit        String
  reorderLevel Int
  unitCost    Decimal  @db.Decimal(12, 2)
  supplierId  String?
  supplier    Supplier? @relation(fields: [supplierId], references: [id])

  transactions InventoryTransaction[]
}

model Supplier {
  id    String @id @default(cuid())
  name  String
  items InventoryItem[]
}

model InventoryTransaction {
  id         String   @id @default(cuid())
  itemId     String
  item       InventoryItem @relation(fields: [itemId], references: [id])
  type       String   // Stock In | Stock Out | Adjustment
  quantity   Int
  reason     String?
  recordedById String
  createdAt  DateTime @default(now())

  @@index([itemId])
}

// ---------------------------------------------------------------------------
// WEBINAR / LEADS / FOLLOW-UPS
// ---------------------------------------------------------------------------

model WebinarSession {
  id                   String   @id @default(cuid())
  sessionDisplayId     String   @unique // e.g. WEB-2026-000001
  title                String
  description          String?
  type                 String   // configurable, not hard-coded — matches TrainingSession's convention
  date                 DateTime
  startTime            String
  endTime              String
  platform             String
  meetingLink          String?
  meetingId            String?
  passcode             String?
  host                 String?
  capacity             Int?
  registrationOpenDate DateTime?
  registrationCloseDate DateTime?
  status               String   @default("Draft") // Draft | Upcoming | Registration Open | Registration Closed | Ongoing | Completed | Cancelled | Archived
  notes                String?
  createdById          String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  registrations WebinarRegistration[]
}

// One row per Lead+Session — the @@unique constraint is the structural
// guard against a duplicate registration to the SAME session, while still
// allowing the SAME Lead to hold many rows across DIFFERENT sessions
// (spec section 9: one Lead, multiple webinar registrations, history never
// overwritten).
model WebinarRegistration {
  id               String   @id @default(cuid())
  sessionId        String
  session          WebinarSession @relation(fields: [sessionId], references: [id])
  leadId           String
  lead             Lead     @relation(fields: [leadId], references: [id])
  registeredAt     DateTime @default(now())
  // LATEST-touch attribution, captured at THIS registration — distinct
  // from Lead's own first-touch fields, which this never overwrites (spec
  // section 12).
  source           String?
  campaign         String?
  utmSource        String?
  utmMedium        String?
  utmCampaign      String?
  utmContent       String?
  utmTerm          String?
  landingPage      String?
  referralSource   String?
  registrationStatus String @default("Registered") // Registered | Cancelled
  attendanceStatus String   @default("Registered") // Registered | Attended | Completed Webinar | Left Early | No Show | Cancelled
  consentReference String?  // the LeadConsentEvent id captured at registration time, if any
  notes            String?
  recordedById     String?
  recordedAt       DateTime?

  @@unique([sessionId, leadId])
  @@index([sessionId])
  @@index([leadId])
}

model FollowUp {
  id              String   @id @default(cuid())
  leadId          String
  lead            Lead     @relation(fields: [leadId], references: [id])
  purpose         String?
  channel          String  // Phone | Messenger | SMS | Email | WhatsApp | Viber | Other — reference only, never a delivery claim
  status          String   @default("Scheduled") // Scheduled | Due | Completed | No Response | Rescheduled | Cancelled
  scheduledFor    DateTime
  completedAt     DateTime?
  assignedStaffId String?
  outcome         String?
  notes           String?
  nextFollowUpAt  DateTime?
  taskId          String?  @unique
  createdById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([leadId])
  @@index([assignedStaffId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// FEEDBACK / TESTIMONIALS / INCENTIVES — private feedback and marketing
// consent are independently tracked, never implied by each other (spec
// section 16's "must not be broken" list).
// ---------------------------------------------------------------------------

model FeedbackRequest {
  id            String   @id @default(cuid())
  requestDisplayId String @unique // e.g. FREQ-2026-000001
  title         String
  sourceType    String   // Course | Module | Masterclass | Workshop | Face-to-Face Training | Zoom Training | Free Webinar | Full Program | Special Event | Other
  sourceId      String?
  sourceLabel   String?
  batchId       String?
  batch         Batch?   @relation(fields: [batchId], references: [id])
  audience      String   @default("All Eligible Students") // All Eligible Students | Individual Student
  audienceStudentId String?
  message       String?
  questionsJson Json
  allowWritten  Boolean  @default(true)
  allowVideo    Boolean  @default(true)
  incentiveId   String?
  incentive     Incentive? @relation(fields: [incentiveId], references: [id])
  openDate      DateTime @default(now())
  closeDate     DateTime?
  status        String   @default("Open") // Draft | Open | Closed
  createdById   String?
  createdAt     DateTime @default(now())

  submissions FeedbackSubmission[]

  @@index([batchId])
  @@index([status])
}

model FeedbackSubmission {
  id            String   @id @default(cuid())
  feedbackDisplayId String @unique // e.g. FDBK-2026-000001
  requestId     String?
  request       FeedbackRequest? @relation(fields: [requestId], references: [id])
  studentId     String?
  student       Student? @relation(fields: [studentId], references: [id])
  leadId        String?
  lead          Lead?    @relation(fields: [leadId], references: [id])
  sourceType    String
  sourceId      String?
  sourceLabel   String?
  batchId       String?
  rating        Int?
  writtenText   String?
  videoDocumentId String?
  videoDocument Document? @relation(fields: [videoDocumentId], references: [id])
  answersJson   Json?
  // Submitted | Reviewed | Approved for Marketing | Kept Private | Featured | Archived
  status        String   @default("Submitted")
  reviewedById  String?
  reviewedAt    DateTime?
  internalNotes String?
  marketingTagsJson Json? // internal organization tags only, never shown publicly
  incentiveId   String?
  createdAt     DateTime @default(now())

  marketingConsent MarketingConsent?
  incentiveRedemptions IncentiveRedemption[]

  // Exactly one of studentId / leadId is ever set — enforced at the service
  // layer (server/src/modules/feedback/routes.ts), matching the existing
  // frontend rule.
  @@index([studentId])
  @@index([leadId])
  @@index([status])
}

// Append-only consent history (spec sections 41-42) — `status` here is a
// convenience cache of the latest ConsentEvent, kept in sync on every
// write; the ConsentEvent trail is the actual source of truth and is never
// overwritten or deleted, so a withdrawal never erases the fact consent was
// once granted.
model MarketingConsent {
  id            String   @id @default(cuid())
  feedbackSubmissionId String @unique
  feedbackSubmission FeedbackSubmission @relation(fields: [feedbackSubmissionId], references: [id])
  status        String   @default("Withdrawn") // Granted | Withdrawn — cache of the latest event
  consentVersion String
  permittedAssetsJson Json
  events        ConsentEvent[]
}

model ConsentEvent {
  id           String   @id @default(cuid())
  consentId    String
  consent      MarketingConsent @relation(fields: [consentId], references: [id], onDelete: Cascade)
  status       String   // Granted | Withdrawn
  permittedAssetsJson Json
  occurredAt   DateTime @default(now())
  source       String
}

model Incentive {
  id          String   @id @default(cuid())
  name        String
  description String?
  eligibility String?
  sourceTypeFilter String? // a FeedbackSourceType value, or "Any"
  // Bonus Course | PDF | Template | Checklist | Prompt Pack | Recorded Training | Digital Resource | Coupon / Offer | Other
  deliveryType String
  bonusCourseId String?
  bonusCourse Course? @relation(fields: [bonusCourseId], references: [id])
  resourceDocumentId String?
  resourceDocument Document? @relation(fields: [resourceDocumentId], references: [id])
  status      String   @default("Active") // Active | Inactive
  createdAt   DateTime @default(now())

  redemptions IncentiveRedemption[]
  feedbackRequests FeedbackRequest[]
}

// The reward is for SUBMITTING genuine feedback, never for a positive
// rating (spec section 46) — nothing in this model or the route that
// creates it reads FeedbackSubmission.rating before unlocking.
model IncentiveRedemption {
  id           String   @id @default(cuid())
  incentiveId  String
  incentive    Incentive @relation(fields: [incentiveId], references: [id])
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id])
  feedbackSubmissionId String
  feedbackSubmission FeedbackSubmission @relation(fields: [feedbackSubmissionId], references: [id])
  status       String   @default("Unlocked") // Unlocked | Delivered
  deliveredAt  DateTime?
  notes        String?
  createdAt    DateTime @default(now())

  @@unique([incentiveId, feedbackSubmissionId])
  @@index([studentId])
}

// ---------------------------------------------------------------------------
// COMMUNICATIONS / GHL — every send/sync status is honest (Sent/Skipped/
// Failed only — no fabricated "Delivered" without a real provider webhook),
// exactly matching the existing simulated architecture's intent.
// ---------------------------------------------------------------------------

model MessageTemplate {
  id            String   @id @default(cuid())
  name          String
  channel       String   // Email | SMS | WhatsApp | Manual Viber | Manual Messenger | Other
  purpose       String?
  audience      String?
  body          String
  // The declared-safe variable names this template may reference (spec
  // section 47) — e.g. ["firstName","webinarDate","batch"]. Enforced at
  // render/preview time so a template can never interpolate a field it
  // didn't declare.
  variablesJson Json?
  status        String   @default("Draft") // Draft | Active | Archived
  version       Int      @default(1)
  createdById   String?
  updatedById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  communications CommunicationLog[]
}

// personId is the stable anchor (a Person may be BOTH a Lead and a
// Student — Phase 4's existing-student-registers-for-webinar case);
// leadId/studentId are denormalized snapshots for the spec's own field
// list (section 52), never the join key.
model CommunicationLog {
  id                String   @id @default(cuid())
  personId          String
  person            Person   @relation(fields: [personId], references: [id])
  leadId            String?
  studentId         String?
  channel           String
  templateId        String?
  template          MessageTemplate? @relation(fields: [templateId], references: [id])
  triggerEvent      String?  // the DomainEvent type that caused this, or "Manual" / "Bulk"
  provider          String   @default("GHL") // GHL | Manual
  externalMessageId String?
  // Queued | Sent | Delivered | Read | Failed | Skipped | Cancelled — never
  // set to Delivered/Read without real provider confirmation (spec 53).
  status            String
  reason            String?  // required context for Skipped/Failed (spec 54)
  queuedAt          DateTime @default(now())
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  failedAt          DateTime?
  sentById          String?  // staff who triggered a manual send

  @@index([personId])
  @@index([leadId])
  @@index([studentId])
  @@index([status])
}

model GhlContactMap {
  id                String   @id @default(cuid())
  personId          String   @unique
  person            Person   @relation(fields: [personId], references: [id])
  leadId            String?
  studentId         String?
  ghlContactId      String?
  ghlLocationId     String?
  // NOT_SYNCED | QUEUED | SYNCING | SYNCED | FAILED | RETRYING | CONFLICT
  syncStatus        String   @default("NOT_SYNCED")
  lastSyncedAt      DateTime?
  lastSyncDirection String?  // Outbound | Inbound
  lastError         String?
  possibleDuplicate Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// The outbox/retry-queue row for ONE (DomainEvent -> GHL action) pair
// (spec sections 14, 29-31, 47). idempotencyKey is the actual duplicate-
// processing guard — a unique DB constraint, not an in-memory check —
// derived deterministically from the DomainEvent id, so reprocessing the
// same event can never create a second row (spec section 31, 68).
model IntegrationOutboxEvent {
  id                String   @id @default(cuid())
  domainEventId     String   @unique
  domainEvent       DomainEvent @relation(fields: [domainEventId], references: [id])
  idempotencyKey    String   @unique
  eventType         String
  personId          String?
  // QUEUED | PROCESSING | SUCCESS | FAILED | RETRYING | DEAD_LETTER
  status            String   @default("QUEUED")
  attemptCount      Int      @default(0)
  lastAttemptAt     DateTime?
  nextRetryAt       DateTime?
  lastError         String?
  lastErrorCategory String?  // Timeout | RateLimited | AuthenticationFailed | PermanentError | NetworkError | NotConfigured
  resolvedAt        DateTime?
  resolvedById      String?  // staff who manually retried/resolved a dead-lettered row
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([status])
  @@index([personId])
}

// Inbound webhook deduplication (spec section 36) — HighLevel may deliver
// the same webhook more than once; externalEventId is the real guard, not
// a best-effort check.
model GhlWebhookEvent {
  id              String   @id @default(cuid())
  externalEventId String   @unique
  eventType       String?
  signatureValid  Boolean
  payloadJson     Json
  processedAt     DateTime?
  processingNote  String?
  receivedAt      DateTime @default(now())
}

// M.A.I.A. EVENT/STATUS -> GHL TAG (spec section 12) — a real admin-edited
// table, never a hard-coded switch statement in application code.
model GhlTagMapping {
  id         String   @id @default(cuid())
  eventKey   String   @unique // e.g. "WEBINAR_REGISTERED", "STUDENT_FULLY_PAID"
  ghlTagName String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// M.A.I.A. FIELD -> GHL CUSTOM FIELD (spec section 11) — the GHL custom
// field ID lives here, never inlined into route code.
model GhlCustomFieldMapping {
  id         String   @id @default(cuid())
  maiaField  String   @unique // e.g. "batch", "package", "paymentStatus"
  ghlFieldId String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// M.A.I.A. EVENT -> GHL WORKFLOW (spec section 13).
model GhlWorkflowMapping {
  id            String   @id @default(cuid())
  eventKey      String   @unique
  ghlWorkflowId String
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Singleton operational config row — NEVER holds secret material (spec
// section 3). The real Private Integration Token / webhook signing key
// live ONLY in this server process's own environment variables
// (GHL_PRIVATE_INTEGRATION_TOKEN, GHL_WEBHOOK_SIGNATURE_PUBLIC_KEY),
// never in this table, never in git, never sent to the frontend.
model GhlIntegrationConfig {
  id                         String   @id @default("singleton")
  connectionMode             String   @default("PRIVATE_INTEGRATION") // PRIVATE_INTEGRATION | OAUTH
  locationId                 String?
  operatingMode              String   @default("TEST") // TEST | PRODUCTION — never auto-switches (spec section 58)
  status                     String   @default("NOT_CONNECTED") // NOT_CONNECTED | CONNECTED | AUTHENTICATION_FAILED | INSUFFICIENT_PERMISSIONS | RATE_LIMITED | CONNECTION_ERROR
  lastSuccessfulConnectionAt DateTime?
  lastSyncAt                 DateTime?
  webhookStatus              String   @default("NOT_CONFIGURED") // NOT_CONFIGURED | RECEIVING | NO_RECENT_DELIVERIES
  testContactIdsJson         Json?    // allow-list of real GHL contact ids permitted to receive messages while in TEST mode
  updatedById                String?
  updatedAt                  DateTime @updatedAt
}

model AutomationRule {
  id                String   @id @default(cuid())
  name              String
  triggerEvent      String
  conditionJson     Json?
  actionsJson       Json
  stopConditionsJson Json?   // e.g. ["LEAD_CONVERTED","STUDENT_FULLY_PAID","LEAD_OPTED_OUT"] (spec section 51)
  status            String   @default("Draft") // Draft | Active | Paused | Archived — Draft NEVER executes (spec section 50)
  createdById       String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  executions AutomationExecution[]
}

// Idempotency, for real, at the database level (spec section 31) — the
// unique constraint below is what actually prevents a duplicate execution,
// not just an in-memory check.
model AutomationExecution {
  id             String   @id @default(cuid())
  ruleId         String
  rule           AutomationRule @relation(fields: [ruleId], references: [id])
  eventType      String
  personType     String
  personId       String
  occurredAtKey  String   // the event's own occurredAt, part of the idempotency key
  executedAt     DateTime @default(now())

  @@unique([ruleId, eventType, personType, personId, occurredAtKey])
}

// ---------------------------------------------------------------------------
// AI BUSINESS TOOLS — AiGeneration pins the exact MasterBrainDocument
// version it was generated from and is never re-pointed (spec section 16).
// Phase 6 extends this Phase-1 stub into a real, config-driven Tool
// Library: one generic generation engine reads AiTool + its ACTIVE
// PromptVersion + its AiModelConfig, rather than 18 hand-coded endpoints
// (spec sections 8-9, 25) — see server/src/modules/ai-tools/engine.ts.
// ---------------------------------------------------------------------------

// Centralized, provider-agnostic model configuration (spec section 8) — no
// model name is ever hard-coded in application code; every call site reads
// one of these rows by key. `enabled: false` is this config's own kill
// switch (spec section 65), independent of the tool's own status and the
// provider's own enabled flag.
model AiModelConfig {
  id            String   @id @default(cuid())
  configKey     String   @unique // "default" | "reasoning" | "structured-analytical" | ...
  provider      String   // "ANTHROPIC" | "OPENAI" | "GOOGLE"
  model         String   // e.g. "claude-opus-5"
  purpose       String?
  temperature   Float?
  maxOutputTokens Int    @default(4096)
  supportsStructuredOutput Boolean @default(true)
  fallbackConfigKey String? // another AiModelConfig.configKey, resolved at call time
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tools AiTool[]
}

// Real backend for the ADMIN -> AI CONNECTIONS screen (spec section 6) —
// NEVER holds the actual API key (spec section 4): that lives only in this
// server process's own environment variables (ANTHROPIC_API_KEY, ...).
model AiProviderConfig {
  id                      String   @id @default(cuid())
  provider                String   @unique // "ANTHROPIC" | "OPENAI" | "GOOGLE"
  enabled                 Boolean  @default(true) // kill switch (spec section 65)
  environment             String   @default("TEST") // TEST | PRODUCTION — never auto-switches
  status                  String   @default("NOT_CONNECTED") // NOT_CONNECTED | CONNECTED | AUTHENTICATION_FAILED | MODEL_UNAVAILABLE | RATE_LIMITED | QUOTA_BILLING_ISSUE | PROVIDER_ERROR | CONFIGURATION_ERROR
  lastSuccessfulRequestAt DateTime?
  lastErrorAt             DateTime?
  lastErrorMessage        String?
  updatedById             String?
  updatedAt               DateTime @updatedAt
}

model AiTool {
  id          String   @id @default(cuid())
  toolKey     String   @unique // "business-strategist", ...
  name        String
  description String?
  category    String
  status      AiToolStatus @default(ACTIVE)
  displayOrder Int
  modelConfigId String?
  modelConfig   AiModelConfig? @relation(fields: [modelConfigId], references: [id])
  inputSchemaJson  Json?
  outputSchemaJson Json?
  usageRulesJson   Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  promptVersions PromptVersion[]
  manualGrants   AiManualGrant[]
  generations    AiGeneration[]
  usageLimits    AiUsageLimit[]
  handoffTargets AiHandoff[]
}

enum AiToolStatus {
  ACTIVE
  INACTIVE
  COMING_SOON
}

model PromptVersion {
  id          String   @id @default(cuid())
  toolId      String
  tool        AiTool   @relation(fields: [toolId], references: [id])
  name        String?
  version     Int
  systemInstruction String
  status      PromptVersionStatus @default(DRAFT)
  changeNotes String?
  updatedById String
  createdAt   DateTime @default(now())
  publishedAt DateTime?

  generations AiGeneration[]

  @@unique([toolId, version])
}

enum PromptVersionStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model AiProject {
  id          String   @id @default(cuid())
  projectDisplayId String @unique // e.g. PROJ-2026-000001
  studentId   String
  businessId  String
  business    Business @relation(fields: [businessId], references: [id])
  name        String
  type        String
  masterBrainVersionAtCreation Int?
  createdAt   DateTime @default(now())

  generations AiGeneration[]

  @@index([studentId])
  @@index([businessId])
}

model AiGeneration {
  id           String   @id @default(cuid())
  generationDisplayId String @unique // e.g. GEN-2026-000001
  studentId    String
  businessId   String
  business     Business @relation(fields: [businessId], references: [id])
  projectId    String?
  project      AiProject? @relation(fields: [projectId], references: [id])
  toolId       String
  tool         AiTool   @relation(fields: [toolId], references: [id])
  promptVersionId String?
  promptVersion   PromptVersion? @relation(fields: [promptVersionId], references: [id])
  masterBrainDocumentId String?
  masterBrainDocument   MasterBrainDocument? @relation(fields: [masterBrainDocumentId], references: [id])
  masterBrainVersion    Int?
  provider      String?
  model         String?
  userInputJson Json
  outputJson    Json?
  // QUEUED | GENERATING | COMPLETED | FAILED | CANCELLED (spec section 57)
  status        String
  failureReason String?
  errorCategory String? // ProviderUnavailable | RateLimited | QuotaExhausted | InvalidApiKey | ModelRemoved | Timeout | InvalidStructuredOutput | ContextTooLarge | SafetyRejection | NetworkError
  usageJson     Json?   // provider-reported input/output token counts, never a cost figure shown to Students
  validationJson Json?  // missing-section / unsupported-claim flags (spec sections 74-75)
  retryOfGenerationId String? // points at the ORIGINAL failed generation this retried (spec section 58) — failure history is never overwritten
  requestedAt   DateTime @default(now())
  completedAt   DateTime?
  favorited     Boolean @default(false)
  archived      Boolean @default(false)
  createdAt     DateTime @default(now())

  handoffsAsSource      AiHandoff[] @relation("HandoffSource")
  handoffAsDestination  AiHandoff?  @relation("HandoffDestination")

  @@index([studentId])
  @@index([businessId])
  @@index([projectId])
}

// Structured cross-tool handoff (spec sections 66-67) — a deliberate
// excerpt, never the full raw conversation, so a destination tool only
// ever receives what its own request actually needs.
model AiHandoff {
  id                      String   @id @default(cuid())
  sourceGenerationId      String
  sourceGeneration        AiGeneration @relation("HandoffSource", fields: [sourceGenerationId], references: [id])
  destinationToolId       String
  destinationTool         AiTool   @relation(fields: [destinationToolId], references: [id])
  selectedSectionsJson    Json
  userInstructions        String?
  destinationGenerationId String?  @unique
  destinationGeneration   AiGeneration? @relation("HandoffDestination", fields: [destinationGenerationId], references: [id])
  createdAt               DateTime @default(now())
}

model AiPackageAccess {
  id        String  @id @default(cuid())
  packageId String
  package   Package @relation(fields: [packageId], references: [id])
  toolKey   String

  @@unique([packageId, toolKey])
}

model AiManualGrant {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id])
  toolId    String
  tool      AiTool   @relation(fields: [toolId], references: [id])
  reason    String?
  grantedById String
  grantedAt DateTime @default(now())

  @@unique([studentId, toolId])
}

// Configurable usage caps (spec sections 59-60) — GLOBAL applies to every
// Student; PACKAGE/TOOL/PACKAGE_TOOL narrow it. Usage itself is always
// live-counted from AiGeneration (never a separately stored counter),
// matching this codebase's established "derive, never store" rule.
model AiUsageLimit {
  id           String   @id @default(cuid())
  scope        String   // GLOBAL | PACKAGE | TOOL | PACKAGE_TOOL
  packageId    String?
  package      Package? @relation(fields: [packageId], references: [id])
  toolId       String?
  tool         AiTool?  @relation(fields: [toolId], references: [id])
  dailyLimit   Int?
  monthlyLimit Int?
  updatedById  String?
  updatedAt    DateTime @updatedAt

  @@unique([scope, packageId, toolId])
}

// ---------------------------------------------------------------------------
// CROSS-CUTTING: ACTIVITY LOG / SUPPORT / ANNOUNCEMENTS
// ---------------------------------------------------------------------------

// Polymorphic actor: either a User (staff/owner) or a Student acted.
// Never stores passwords/secrets — enforced by convention in
// server/src/audit/log.ts, which whitelists loggable fields per action.
model ActivityLog {
  id           String   @id @default(cuid())
  actorUserId  String?
  actorUser    User?    @relation("ActorUser", fields: [actorUserId], references: [id])
  actorStudentId String?
  actorStudent Student? @relation("ActorStudent", fields: [actorStudentId], references: [id])
  action       String
  entityType   String?
  entityId     String?
  summary      String
  occurredAt   DateTime @default(now())

  @@index([actorUserId])
  @@index([actorStudentId])
  @@index([action])
  @@index([occurredAt])
}

model SupportRequest {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id])
  category  String
  message   String
  status    String   @default("Open")
  createdAt DateTime @default(now())

  @@index([studentId])
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String
  targeting Json
  isPinned  Boolean  @default(false)
  isImportant Boolean @default(false)
  publishedById String
  createdAt DateTime @default(now())
}
