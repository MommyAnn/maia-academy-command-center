# M.A.I.A. server — environment template.
# Copy to .env.development / .env.staging / .env.production and fill in real
# values for that environment. NEVER commit a filled-in .env.* file — only
# this .env.example template is tracked in git. Each environment (Dev,
# Staging, Production) must have its OWN database, secrets, and credentials
# — never share one across environments (spec section 27).

NODE_ENV=development

# Postgres connection string for THIS environment's own database.
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Long random secret used to hash session/reset tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotate per environment. Never reuse the Development secret in Staging/Production.
SESSION_SECRET="replace-with-a-long-random-value"

# How long a session stays valid before re-authentication is required.
SESSION_TTL_HOURS=12

# Cookie is marked Secure (HTTPS-only) automatically when NODE_ENV=production.
COOKIE_DOMAIN=localhost

# Where uploaded files are stored. "local" is the Phase 1 Development
# implementation only (see server/src/storage) — Staging/Production must set
# this to "s3" once real object-storage credentials exist. Never use "local"
# in Production.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads-dev

# Required only when STORAGE_DRIVER=s3 (not used/validated in Phase 1):
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

PORT=4000

# Requests-per-minute ceiling on the login endpoint (brute-force protection).
LOGIN_RATE_LIMIT_PER_MINUTE=10

# The frontend's own origin — the only origin allowed to send credentialed
# (cookie-carrying) requests to this API. Must match exactly (scheme + host
# + port); never a wildcard.
CORS_ORIGIN=http://localhost:5173

# --- Phase 5: GHL / HighLevel integration (all optional — the app boots and
# every non-GHL feature works with none of these set; see
# docs/ENVIRONMENT_VARIABLES.md for what each one does and how to verify it) ---
# GHL_PRIVATE_INTEGRATION_TOKEN=
# GHL_LOCATION_ID=
# GHL_WEBHOOK_SIGNATURE_PUBLIC_KEY=
# GHL_API_BASE_URL=https://services.leadconnectorhq.com
# GHL_API_VERSION=2021-07-28

# --- Phase 6: AI provider (all optional — the app boots and every non-AI
# feature works with none of these set) ---
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_AI_API_KEY=
