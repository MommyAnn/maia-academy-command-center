# Server (Phase 1 production backend) — never commit real secrets or
# environment files, only server/.env.example is tracked.
server/node_modules
server/dist
server/.env
server/.env.*
!server/.env.example
server/uploads-dev
server/uploads-test
server/generated
# Real pg_dump backup files (spec sections 43-46) — never committed, since a
# dump can contain real Person/Payment data once run against a real
# environment; scripts/backup.sh writes here by default.
server/backups
